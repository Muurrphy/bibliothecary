# Copy to .env and enter YOUR own credentials. Never commit .env.
OPENAI_API_KEY=
# For `biblio telegram`: the token @BotFather gives you when you create a bot.
TELEGRAM_BOT_TOKEN=
# Optional: a free OpenAlex key for more paper searches a day (https://openalex.org).
# OPENALEX_API_KEY=
MARGIN_MODEL=gpt-4.1-mini
# The librarian's conversation and choice of readings need judgement: a stronger model can be set
# for them alone, e.g. a gpt-5 class model your account has. Empty = MARGIN_MODEL.
BIBLIOTHECARY_CHAT_MODEL=
# Reasoning models (gpt-5…, o3…) think before answering, which is slower for spoken answers.
# To make them think less, set an effort your model accepts, e.g.:
# MARGIN_REASONING_EFFORT=low
MARGIN_REALTIME=1
# Realtime voice questions use OpenAI; compatible chat endpoints can use MARGIN_REALTIME=0.
# MARGIN_BASE_URL=https://api.openai.com/v1
# MARGIN_REALTIME_MODEL=<a realtime model available to your account>

# The voice on the phone (and the moving mouth). Leave these empty and the reading room is silent.
# Any ElevenLabs voice works, including your own cloned voice (ELEVENLABS_VOICE_ID is accepted too).
ELEVENLABS_API_KEY=
MARGIN_ELEVEN_VOICE=
# Pin a TTS model supported by your account if desired:
# MARGIN_ELEVEN_MODEL=eleven_v4
# Optional macOS Keychain service containing YOUR ElevenLabs credential:
# MARGIN_ELEVENLABS_KEYCHAIN=Margin ElevenLabs API Key
# Optional JSON voice settings; strict mode fails instead of silently dropping them.
# MARGIN_ELEVEN_SETTINGS={"stability":0.6,"similarity_boost":0.9,"style":0.1,"use_speaker_boost":true,"speed":0.97}
MARGIN_ELEVEN_STRICT_SETTINGS=1

# One phone is the microphone/speaker; other screens can be muted mouths.
MARGIN_SINGLE_SPEAKER=1
# Require provider character timestamps; unsupported models pause with an error.
MARGIN_NATIVE_TIMING=1
# With strict timing disabled, estimate locally rather than upload for forced alignment.
MARGIN_ALIGN=local
MARGIN_VISUAL_LEAD_MS=0
# Optional local cache; contains generated audio and spoken text.
# MARGIN_VOICE_CACHE_DIR=.margin-cache

# The optional examples/elevenlabs_http.py adapter also uses:
# ELEVENLABS_VOICE_ID=<your voice ID>
