include README.md README.zh-CN.md LICENSE CHANGELOG.md CONTRIBUTING.md SECURITY.md CITATION.cff .env.example
recursive-include docs *.md
recursive-include examples *.py *.json *.jsonl *.md
recursive-include schemas *.json
recursive-include assets *.svg
