{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Muurrphy/robot-lipsync/schemas/articulation-event-v1.schema.json",
  "title": "Robot LipSync Articulation Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "session_id", "start_ms", "duration_ms", "viseme", "articulation", "intensity", "language", "confidence", "metadata"],
  "properties": {
    "schema": {"const": "robot-lipsync/articulation-event/v1"},
    "session_id": {"type": "string", "minLength": 1},
    "start_ms": {"type": "number", "minimum": 0},
    "duration_ms": {"type": "number", "minimum": 0},
    "viseme": {"type": "string", "minLength": 1},
    "intensity": {"type": "number", "minimum": 0, "maximum": 1},
    "language": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "metadata": {"type": "object"},
    "articulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jaw_open", "lip_separation", "mouth_width", "lip_round", "lip_press", "lip_protrusion", "lower_lip_tuck", "asymmetry"],
      "properties": {
        "jaw_open": {"type": "number", "minimum": 0, "maximum": 1},
        "lip_separation": {"type": "number", "minimum": 0, "maximum": 1},
        "mouth_width": {"type": "number", "minimum": 0, "maximum": 1},
        "lip_round": {"type": "number", "minimum": 0, "maximum": 1},
        "lip_press": {"type": "number", "minimum": 0, "maximum": 1},
        "lip_protrusion": {"type": "number", "minimum": 0, "maximum": 1},
        "lower_lip_tuck": {"type": "number", "minimum": 0, "maximum": 1},
        "asymmetry": {"type": "number", "minimum": -1, "maximum": 1}
      }
    }
  }
}
